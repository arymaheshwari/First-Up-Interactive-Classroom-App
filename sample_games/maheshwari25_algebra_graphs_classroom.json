{
  "format": "buzzer/game",
  "version": 1,
  "game": {
    "title": "Algebra I: Lines, Parabolas and Their Graphs",
    "description": "A classroom check-in for an Algebra I unit on graphing. Students plot points on the coordinate grid (Pin It), estimate values, and answer concept questions on slope, intercepts and vertices. Ends with two participation questions to guide the next lesson.",
    "max_players": 150
  },
  "questions": [
    {
