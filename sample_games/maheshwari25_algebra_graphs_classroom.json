        "grid": { "xMin": -5, "xMax": 5, "yMin": -5, "yMax": 5, "step": 1 },
        "snap": true
      },
      "answer_data": {},
      "time_limit_seconds": 20,
      "points_value": 1.0
    },
    {
      "type": "multiple_choice",
      "grading_type": "ACCURACY",
      "prompt": "What is the slope of the line through the points (1, 2) and (3, 8)?",
      "config": {
        "options": ["2", "3", "4", "6"]
      },
      "answer_data": {
        "answer_points": [0.0, 1.0, 0.0, 0.0]
      },
      "time_limit_seconds": 30,
      "points_value": 1.0
